{
  "name": "muni-training-evidence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "sass src/styles/app.scss public/app.css --style=compressed --no-source-map",
    "build": "npm run build:css && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "import": "tsx scripts/import/run.ts",
    "test:e2e": "playwright test",
    "seed:local": "wrangler d1 execute DB --local --file data/seed.sql > /tmp/muni-seed-local.log && wrangler d1 execute DB --local --file data/activate.sql",
    "smoke": "node scripts/verify/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "csv-parse": "^7.0.3",
    "iconv-lite": "^0.7.0",
    "sass": "^1.93.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.43.0"
  }
}
